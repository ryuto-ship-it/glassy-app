{
  "expo": {
    "name": "CHARM",
    "slug": "glassy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/charmacist-logo.png",
    "scheme": "glassyapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0D",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/charmacist-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/charmacist-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/charmacist-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0D"
        }
      ],
      "expo-image",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/glassy-app"
    }
  }
}
